# 手柄按键组（数字开关态：1=按下，0=未按下）
uint8 a        # A 键（BtnA，下方）
uint8 b        # B 键（BtnB，右侧）
uint8 c        # C 键（BtnC）
uint8 x        # X 键（BtnX，左侧）
uint8 y        # Y 键（BtnY，上方）
uint8 z        # Z 键（BtnZ）
uint8 l3       # 左摇杆按下 L3（本机无此键，恒 0）
uint8 r3       # 右摇杆按下 R3（本机无此键，恒 0）
uint8 select   # 选择键 BtnSelect
uint8 start    # 开始键 BtnStart
uint8 mode     # 模式键 BtnMode
